<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pkc</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pkc</ToolCommandName>
    <PackageId>RuaDen.Pkc.Tool</PackageId>
    <Version>0.4.3-preview.2</Version>
    <Authors>rua-den</Authors>
    <Description>Product Knowledge Compiler: compile grounded implementation evidence into portable product knowledge.</Description>
    <RepositoryUrl>https://github.com/rua-den/pkc</RepositoryUrl>
    <PackageTags>product-knowledge;documentation;roslyn;ai;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Pkc.Core/Pkc.Core.csproj" />
    <ProjectReference Include="../Pkc.CSharp/Pkc.CSharp.csproj" />
    <ProjectReference Include="../Pkc.Frontend/Pkc.Frontend.csproj" />
    <ProjectReference Include="../Pkc.Knowledge/Pkc.Knowledge.csproj" />
  </ItemGroup>
</Project>
